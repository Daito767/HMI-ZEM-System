@inherits PlcComponentBase
@inject HmiSettingsStore Store

<div class="grid cols-2">
    <div class="panel">
        <header><h2>Conexiune</h2></header>
        <div class="body">
            @* The fields and the button that sends them are one command, so one band. *@
            <div class="actions">
                <div class="check">
                    <input type="checkbox" id="sim" checked="@_edit.UseSimulator"
                           @onchange="e => _edit.UseSimulator = (bool)(e.Value ?? false)"/>
                    <label for="sim">Foloseste simulatorul intern (fara PLC)</label>
                </div>

                <div class="field">
                    <label for="url">Endpoint OPC UA</label>
                    <input type="text" id="url" value="@_edit.EndpointUrl" disabled="@_edit.UseSimulator"
                           @onchange="e => _edit.EndpointUrl = e.Value?.ToString() ?? string.Empty"/>
                </div>

                <div class="check">
                    <input type="checkbox" id="sec" checked="@_edit.UseSecurity" disabled="@_edit.UseSimulator"
                           @onchange="e => _edit.UseSecurity = (bool)(e.Value ?? false)"/>
                    <label for="sec">Endpoint securizat (semnat si criptat)</label>
                </div>

                <div class="field">
                    <label for="user">Utilizator</label>
                    <input type="text" id="user" value="@_edit.Username" autocomplete="off"
                           disabled="@(_edit.UseSimulator || _edit.Anonymous)"
                           @onchange="e => _edit.Username = e.Value?.ToString() ?? string.Empty"/>
                </div>

                <div class="field">
                    <label for="pass">Parola</label>
                    <input type="password" id="pass" value="@_edit.Password" autocomplete="off"
                           disabled="@(_edit.UseSimulator || _edit.Anonymous)"
                           @onchange="e => _edit.Password = e.Value?.ToString() ?? string.Empty"/>
                </div>

                <div class="check">
                    <input type="checkbox" id="anon" checked="@_edit.Anonymous" disabled="@_edit.UseSimulator"
                           @onchange="e => _edit.Anonymous = (bool)(e.Value ?? false)"/>
                    <label for="anon">Serverul accepta conectare anonima (fara utilizator)</label>
                </div>

                <div class="field">
                    <label for="poll">Interval de refresh (ms) — MainTask merge la 50 ms</label>
                    <input type="number" id="poll" min="50" max="5000" step="50" value="@_edit.PollIntervalMs"
                           @onchange="e => _edit.PollIntervalMs = ParseInt(e.Value, _edit.PollIntervalMs)"/>
                </div>

                <div class="check">
                    <input type="checkbox" id="auto" checked="@_edit.AutoConnect"
                           @onchange="e => _edit.AutoConnect = (bool)(e.Value ?? false)"/>
                    <label for="auto">Reconectare automata</label>
                </div>

                <div class="commands">
                    <button class="btn primary" @onclick="SaveAndReconnect">Salveaza si reconecteaza</button>
                    <button class="btn" @onclick="Revert">Renunta la modificari</button>
                </div>
            </div>

            @if (_saved is { } saved)
            {
                <p class="faint">Salvat la @saved.ToString("HH:mm:ss").</p>
            }
        </div>
    </div>

    <div class="grid" style="align-content:start">
        <div class="panel">
            <header><h2>Starea legaturii</h2></header>
            <div class="body">
                <table class="data">
                    <tbody>
                    <tr><td>Stare</td><td class="num">@Plc.LinkState</td></tr>
                    <tr><td>Sursa</td><td class="num">@Plc.Endpoint</td></tr>
                    <tr><td>Simboluri legate</td><td class="num">@Plc.Bindings.Count(b => b.Bound) / @Plc.Bindings.Count</td></tr>
                    <tr>
                        <td>Ultima eroare</td>
                        <td class="num">@(Plc.LastError is { Length: > 0 } ? Plc.LastError : "—")</td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

@code {
    private HmiSettings _edit = new();
    private DateTime? _saved;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _edit = Store.Current.Clone();
    }

    private void Revert() => _edit = Store.Current.Clone();

    private async Task SaveAndReconnect()
    {
        await Store.SaveAsync(_edit);
        _saved = DateTime.Now;
        await Plc.ReconnectAsync();
    }

    private static int ParseInt(object? value, int fallback) =>
        int.TryParse(value?.ToString(), out var parsed) ? Math.Clamp(parsed, 50, 5000) : fallback;
}
